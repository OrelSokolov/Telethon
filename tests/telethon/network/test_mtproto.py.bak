                        await sender._recv_loop()

    @pytest.mark.asyncio
    async def test_send_loop_io_error(self, auth_key, mock_loggers, mock_connection):
        """Case: Send loop gets IOError -> Expected behaviour: Starts reconnect"""
        sender = MTProtoSender(auth_key, loggers=mock_loggers)
        sender._connection = mock_connection
        sender._user_connected = True
        sender._reconnecting = False
        
        call_count = [0]
        async def mock_get():
            call_count[0] += 1
            if call_count[0] == 1:
                return ([MagicMock(msg_id=12345)], b'data')
            else:
                sender._user_connected = False
                return ([], b'')
        
        sender._send_queue.get = mock_get
        mock_connection.send.side_effect = IOError('Send failed')
        
        with patch.object(sender, '_start_reconnect', new=Mock()) as mock_reconnect:
            task = asyncio.create_task(sender._send_loop())
            await asyncio.sleep(0.01)
            task.cancel()
            try:
                await task
            except asyncio.CancelledError:
                pass
            
            mock_reconnect.assert_called_once()

    @pytest.mark.asyncio
    async def test_send_loop_non_tlrequest(self, auth_key, mock_loggers, mock_connection):
        """Case: Send loop processes non-TLRequest -> Expected behaviour: Does not add to pending_state"""
        sender = MTProtoSender(auth_key, loggers=mock_loggers)
        sender._connection = mock_connection
        sender._user_connected = True
        
        mock_state = MagicMock()
        mock_state.msg_id = 12345
        mock_state.request = MagicMock()
        
        call_count = [0]
        async def mock_get():
            call_count[0] += 1
            if call_count[0] == 1:
                return ([mock_state], b'data')
            else:
                sender._user_connected = False
                return ([], b'')
        
        sender._send_queue.get = mock_get
        
        task = asyncio.create_task(sender._send_loop())
        await asyncio.sleep(0.01)
        task.cancel()
        try:
            await task
        except asyncio.CancelledError:
            pass
        
        assert 12345 not in sender._pending_state

    @pytest.mark.asyncio
    async def test_send_loop_list_states(self, auth_key, mock_loggers, mock_connection):
        """Case: Send loop processes list of states -> Expected behaviour: Adds TLRequests to pending_state"""
        sender = MTProtoSender(auth_key, loggers=mock_loggers)
        sender._connection = mock_connection
        sender._user_connected = True
        
        mock_state1 = MagicMock()
        mock_state1.msg_id = 12345
        mock_state1.request = MagicMock()
        mock_state1.request.__class__.__bases__ = (TLRequest,)
        
        mock_state2 = MagicMock()
        mock_state2.msg_id = 67890
        mock_state2.request = MagicMock()
        mock_state2.request.__class__.__bases__ = (TLRequest,)
        
        call_count = [0]
        async def mock_get():
            call_count[0] += 1
            if call_count[0] == 1:
                return ([[mock_state1, mock_state2]], b'data')
            else:
                sender._user_connected = False
                return ([], b'')
        
        sender._send_queue.get = mock_get
        
        task = asyncio.create_task(sender._send_loop())
        await asyncio.sleep(0.01)
        task.cancel()
        try:
            await task
        except asyncio.CancelledError:
            pass
        
        assert 12345 in sender._pending_state
        assert 67890 in sender._pending_state

    def test_store_own_updates_updates(self, auth_key, mock_loggers):
        """Case: Storing Updates object -> Expected behaviour: Adds to updates_queue with _self_outgoing=True"""
        from telethon.tl import types as _tl
        
        sender = MTProtoSender(auth_key, loggers=mock_loggers)
        sender._updates_queue = asyncio.Queue()
        
        updates = _tl.Updates(updates=[], users=[], chats=[], date=0, seq=0)
        
        sender._store_own_updates(updates)
        
        assert sender._updates_queue.qsize() == 1
        result = sender._updates_queue.get_nowait()
        assert result._self_outgoing is True

