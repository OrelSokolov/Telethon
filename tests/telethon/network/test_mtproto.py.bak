    @pytest.mark.asyncio
    async def test_start_reconnect_already_reconnecting(self, auth_key, mock_loggers):
        """Case: Calling _start_reconnect when already reconnecting -> Expected behaviour: Keeps _reconnecting=True"""
        sender = MTProtoSender(auth_key, loggers=mock_loggers)
        sender._user_connected = True
        sender._reconnecting = True
        
        # Should not start reconnect if already reconnecting
        sender._start_reconnect(None)
        
        # _reconnecting should remain True
        assert sender._reconnecting is True

    @pytest.mark.asyncio
    async def test_handle_gzip_packed(self, auth_key, mock_loggers):
        """Case: Handling GzipPacked with valid data -> Expected behaviour: Fails on deserialization but tests the path"""
        sender = MTProtoSender(auth_key, loggers=mock_loggers)
        
        # Create a mock gzip-packed message that will deserialized successfully
        # We need to pack a valid TLObject
        from telethon.tl.core import GzipPacked
        
        # Create minimal valid gzip data
        import gzip
        test_data = struct.pack('<i', 0)  # Minimal TL data
        gzipped_data = gzip.compress(test_data)
        gzip_obj = GzipPacked(data=gzipped_data)
        
        message = TLMessage(msg_id=999, seq_no=1, obj=gzip_obj)
        
        # This should fail on deserialization but test the path
        with pytest.raises(Exception):
            await sender._handle_gzip_packed(message)

    @pytest.mark.asyncio
    async def test_send_list_struct_error(self, auth_key, mock_loggers):
        """Case: Sending list where one request raises struct.error -> Expected behaviour: Raises struct.error"""
        sender = MTProtoSender(auth_key, loggers=mock_loggers)
        sender._user_connected = True
        
        class BadRequest(TLRequest):
            def _bytes(self):
                raise struct.error('test')
        
        mock_request1 = MagicMock()
        mock_request1.__bytes__ = Mock(return_value=b'\x01\x02\x03')
        mock_request2 = BadRequest()
        
        with pytest.raises(struct.error):
            sender.send([mock_request1, mock_request2])

    @pytest.mark.asyncio
    async def test_connect_connection_failure(self, auth_key, mock_loggers, mock_connection):
        """Case: Connection fails all retries -> Expected behaviour: Raises ConnectionError"""
        sender = MTProtoSender(auth_key, loggers=mock_loggers)
        sender._connection = mock_connection
        sender._retries = 2
        
        mock_connection.connect.side_effect = IOError('Connection failed')
        
        with pytest.raises(ConnectionError, match='Connection to Telegram failed'):
            await sender._connect()

    @pytest.mark.asyncio
    async def test_disconnect_with_error(self, auth_key, mock_loggers, mock_connection):
        """Case: Disconnecting with error -> Expected behaviour: Sets exception on pending futures"""
        sender = MTProtoSender(auth_key, loggers=mock_loggers)
        sender._connection = mock_connection
        sender._user_connected = True
        sender.__disconnected = asyncio.Future()
        
        mock_state = MagicMock()
        mock_state.future = asyncio.Future()
        sender._pending_state[12345] = mock_state
        
        error = ConnectionError('Test error')
        await sender._disconnect(error=error)
        
        assert sender._user_connected is False
        assert len(sender._pending_state) == 0
        assert mock_state.future.exception() == error

    @pytest.mark.asyncio
    async def test_send_loop_with_pending_ack(self, auth_key, mock_loggers):
        """Case: Send loop with pending acknowledgments -> Expected behaviour: Sends ack messages"""
        sender = MTProtoSender(auth_key, loggers=mock_loggers)
        sender._user_connected = True
        sender._pending_ack.add(12345)
        sender._pending_ack.add(67890)
        
        # Mock send_queue to return empty data to stop the loop
        async def mock_get():
            return ([], b'')
        
        sender._send_queue.get = mock_get
        
        # This should clear pending_ack and add ack message to queue
        task = asyncio.create_task(sender._send_loop())
        await asyncio.sleep(0.01)  # Let the loop run
        task.cancel()
        
        try:
            await task
        except asyncio.CancelledError:
            pass

    @pytest.mark.asyncio
    async def test_send_loop_with_empty_data(self, auth_key, mock_loggers):
        """Case: Send loop receives empty data -> Expected behaviour: Continues without sending"""
        sender = MTProtoSender(auth_key, loggers=mock_loggers)
        sender._user_connected = True
        
        # Mock send_queue to return empty data, then non-empty
        call_count = [0]
        async def mock_get():
            call_count[0] += 1
            if call_count[0] == 1:
                return ([], b'')  # Empty data
            else:
                sender._user_connected = False  # Stop the loop
                return ([], b'\x01')
        
        sender._send_queue.get = mock_get
        sender._connection = MagicMock()
        sender._connection.send = AsyncMock()
        
        task = asyncio.create_task(sender._send_loop())
        
        # Let the loop process both calls
        for _ in range(10):
            await asyncio.sleep(0.01)
            if not sender._user_connected:
                break
        
        task.cancel()
        try:
            await task
        except asyncio.CancelledError:
            pass

