    @pytest.mark.asyncio
    async def test_recv_loop_type_not_found(self, auth_key, mock_loggers):
        """Case: Receive loop gets unknown type -> Expected behaviour: Logs and continues"""
        sender = MTProtoSender(auth_key, loggers=mock_loggers)
        sender._user_connected = True
        sender._connection = MagicMock()
        
        from telethon.tl.types import Bool
        from telethon.extensions import BinaryWriter
        
        # Create valid message with Bool type
        buffer = BytesIO()
        writer = BinaryWriter(buffer)
        bool_obj = Bool(False)
        bool_obj.on_send(writer)
        data = buffer.getvalue()
        
        sender._state.salt = 12345
        encrypted = sender._state.encrypt_message_data(data)
        sender._connection.recv = AsyncMock(return_value=encrypted)
        
        # Set _user_connected to False after one iteration to stop the loop
        call_count = [0]
        original_recv = sender._connection.recv
        async def recv_once():
            call_count[0] += 1
            if call_count[0] == 1:
                return await original_recv()
            raise asyncio.CancelledError()
        
        sender._connection.recv = recv_once
        
        # Should handle TypeNotFoundError and continue
        with pytest.raises(asyncio.CancelledError):
            await sender._recv_loop()

    @pytest.mark.asyncio
    async def test_recv_loop_security_error(self, auth_key, mock_loggers):
        """Case: Receive loop gets security error -> Expected behaviour: Logs and continues"""
        sender = MTProtoSender(auth_key, loggers=mock_loggers)
        sender._user_connected = True
        sender._connection = MagicMock()
        
        # Create message with wrong key_id to trigger SecurityError
        body = struct.pack('<Q', 99999) + os.urandom(16) + os.urandom(32)
        sender._connection.recv = AsyncMock(return_value=body)
        
        call_count = [0]
        async def recv_once():
            call_count[0] += 1
            if call_count[0] == 1:
                return body
            raise asyncio.CancelledError()
        
        sender._connection.recv = recv_once
        
        # Should handle SecurityError and continue
        with pytest.raises(asyncio.CancelledError):
            await sender._recv_loop()

    @pytest.mark.asyncio
    async def test_recv_loop_buffer_error_404(self, auth_key, mock_loggers):
        """Case: Receive loop gets InvalidBufferError with code 404 -> Expected behaviour: Disconnects with AuthKeyNotFound"""
        sender = MTProtoSender(auth_key, loggers=mock_loggers)
        sender._user_connected = True
        sender._connection = MagicMock()
        
        from telethon.extensions import BinaryWriter
        from telethon.tl.types import Bool
        
        # Create message that will fail with 404
        buffer = BytesIO()
        writer = BinaryWriter(buffer)
        bool_obj = Bool(False)
        bool_obj.on_send(writer)
        data = buffer.getvalue()
        
        sender._state.salt = 12345
        encrypted = sender._state.encrypt_message_data(data)
        
        # Patch decrypt_message_data to raise InvalidBufferError with code 404
        async def mock_decrypt(body):
            raise InvalidBufferError(b'', code=404)
        
        sender._state.decrypt_message_data = mock_decrypt
        sender._connection.recv = AsyncMock(return_value=encrypted)
        
        with patch.object(sender, '_disconnect', new=AsyncMock()) as mock_disconnect:
            await sender._recv_loop()
            mock_disconnect.assert_called_once()
            assert isinstance(mock_disconnect.call_args[1]['error'], AuthKeyNotFound)

