    @pytest.mark.asyncio
    async def test_handle_destroy_auth_key_multiple(self, auth_key, mock_loggers):
        """Case: Handling DestroyAuthKey with multiple pending requests -> Expected behaviour: Resolves all"""
        sender = MTProtoSender(auth_key, loggers=mock_loggers)
        
        mock_state1 = MagicMock()
        mock_state1.future = asyncio.Future()
        mock_state1.request = DestroyAuthKeyRequest()
        sender._pending_state[12345] = mock_state1
        
        mock_state2 = MagicMock()
        mock_state2.future = asyncio.Future()
        mock_state2.request = DestroyAuthKeyRequest()
        sender._pending_state[67890] = mock_state2
        
        result = DestroyAuthKeyOk()
        message = TLMessage(msg_id=999, seq_no=1, obj=result)
        
        with patch.object(sender, '_disconnect', new=AsyncMock()):
            await sender._handle_destroy_auth_key(message)
        
        assert 12345 not in sender._pending_state
        assert 67890 not in sender._pending_state
        assert mock_state1.future.done()
        assert mock_state2.future.done()
