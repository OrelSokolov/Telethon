    @pytest.mark.asyncio
    async def test_connect_with_auth_key(self, auth_key, mock_loggers, mock_connection):
        """Case: Connecting with existing auth_key -> Expected behaviour: Skips auth_key generation"""
        sender = MTProtoSender(auth_key, loggers=mock_loggers)
        sender._connection = mock_connection
        sender.auth_key = auth_key
        sender._retries = 1
        
        await sender.connect(mock_connection)
        
        assert sender._user_connected is True
        assert sender._send_loop_handle is not None
        assert sender._recv_loop_handle is not None

    @pytest.mark.asyncio
    async def test_reconnect_success(self, auth_key, mock_loggers, mock_connection):
        """Case: Successful reconnection -> Expected behaviour: Resets state, reconnects"""
        sender = MTProtoSender(auth_key, loggers=mock_loggers)
        sender._connection = mock_connection
        sender._user_connected = True
        sender._reconnecting = True
        sender._retries = 2
        
        mock_state = MagicMock()
        sender._pending_state[12345] = mock_state
        
        async def mock_connect():
            sender._reconnecting = False
        
        with patch.object(sender, '_connect', new=mock_connect):
            await sender._reconnect(None)
        
        assert len(sender._pending_state) == 0
        assert sender._reconnecting is False

    @pytest.mark.asyncio
    async def test_reconnect_invalid_buffer(self, auth_key, mock_loggers, mock_connection):
        """Case: Reconnecting gets invalid buffer (not 404) -> Expected behaviour: Logs warning, continues"""
        sender = MTProtoSender(auth_key, loggers=mock_loggers)
        sender._connection = mock_connection
        sender._user_connected = True
        sender._reconnecting = True
        sender._retries = 2
        
        async def mock_connect():
            raise InvalidBufferError(b'', code=500)
        
        with patch.object(sender, '_connect', new=mock_connect):
            await sender._reconnect(None)  # Should log warning but not disconnect

    @pytest.mark.asyncio
