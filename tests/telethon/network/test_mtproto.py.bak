    @pytest.mark.asyncio
    async def test_handle_rpc_result_success(self, auth_key, mock_loggers):
        """Case: Handling RPC result with success -> Expected behaviour: Sets result on future"""
        sender = MTProtoSender(auth_key, loggers=mock_loggers)
        sender._updates_queue = asyncio.Queue()
        
        from telethon.tl.core import RpcResult
        
        mock_request = MagicMock()
        mock_result = MagicMock()
        mock_request.read_result = Mock(return_value=mock_result)
        
        mock_state = MagicMock()
        mock_state.future = asyncio.Future()
        mock_state.msg_id = 12345
        mock_state.request = mock_request
        sender._pending_state[12345] = mock_state
        
        from io import BytesIO
        buffer = BytesIO()
        buffer.write(b'\x01\x02\x03')
        
        rpc_result = RpcResult(req_msg_id=12345, body=buffer.getvalue(), error=None)
        message = TLMessage(msg_id=999, seq_no=1, obj=rpc_result)
        
        await sender._handle_rpc_result(message)
        
        assert 12345 not in sender._pending_state
        assert mock_state.future.result() is mock_result

    @pytest.mark.asyncio
    async def test_store_own_updates_update_short_message(self, auth_key, mock_loggers):
        """Case: Storing UpdateShortMessage -> Expected behaviour: Adds to updates_queue with _self_outgoing=True"""
        sender = MTProtoSender(auth_key, loggers=mock_loggers)
        sender._updates_queue = asyncio.Queue()
        
        from telethon.tl import types as _tl
        
        update = _tl.UpdateShortMessage(
            id=1,
            user_id=123,
            message='test',
            pts=1,
            pts_count=1,
            date=int(time.time()),
            out=True
        )
        
        sender._store_own_updates(update)
        
        assert sender._updates_queue.qsize() == 1
        stored_update = sender._updates_queue.get_nowait()
        assert stored_update._self_outgoing is True

