    @pytest.mark.asyncio
    async def test_recv_loop_type_not_found(self, auth_key, mock_loggers, mock_connection):
        """Case: Receive loop gets TypeNotFoundError -> Expected behaviour: Logs info, continues"""
        sender = MTProtoSender(auth_key, loggers=mock_loggers)
        sender._connection = mock_connection
        sender._user_connected = True
        
        mock_connection.recv.side_effect = [b'', asyncio.CancelledError()]
        
        with patch.object(sender._state, 'decrypt_message_data', side_effect=[
            TypeNotFoundError(0x12345678, b''),
            asyncio.CancelledError()
        ]):
            with patch.object(sender, '_start_reconnect', new=Mock()):
                with pytest.raises(asyncio.CancelledError):
                    await sender._recv_loop()

