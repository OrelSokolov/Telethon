        sender._connection = mock_connection
        sender._user_connected = True
        
        mock_connection.recv.side_effect = [b'', asyncio.CancelledError()]
        
        mock_message = MagicMock()
        with patch.object(sender._state, 'decrypt_message_data', return_value=mock_message):
            with patch.object(sender, '_process_message', side_effect=[Exception('Process error'), None]):
                with patch.object(sender, '_start_reconnect', new=Mock()):
